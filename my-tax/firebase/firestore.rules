rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'yohaken@gmail.com';
    }

    // กระดานส่งงาน Agent — อ่าน/เขียนผ่าน Admin SDK เป็นหลัก
    // เปิดให้อ่านได้เพื่อดูสถานะจาก client ในอนาคต; เขียนยังจำกัดเจ้าของ
    match /agentHandoff/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
