{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "my-tax/firebase/storage.rules"
  },
  "hosting": [
    {
      "target": "tax",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "mytax",
      "public": "my-tax/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "my-tax",
            "region": "asia-southeast1"
          }
        }
      ]
    }
  ]
}
